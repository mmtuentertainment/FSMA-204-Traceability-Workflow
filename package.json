{
  "name": "fsma-204-workflow-product",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "api:lint": "redocly lint api/openapi.yaml",
    "api:types": "openapi-typescript api/openapi.yaml -o lib/api/generated/openapi-types.ts",
    "api:types:check": "openapi-typescript api/openapi.yaml -o lib/api/generated/openapi-types.ts --check",
    "api:check": "npm run api:lint && npm run api:types:check",
    "db:migrations:check": "drizzle-kit check --config drizzle.config.ts",
    "db:check": "npm run db:migrations:check && npm run test:db-client:import",
    "test:db-client:import": "node --experimental-strip-types tests/db-client-import.test.ts",
    "test:mock-recall:contract": "node tests/mock-recall-contract-smoke.mjs",
    "test:exception-review:patch": "node --experimental-strip-types tests/exception-review-patch.test.ts"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "^16.2.6",
    "pg": "^8.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@redocly/cli": "^2.31.5",
    "@types/node": "^20.19.41",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  }
}
